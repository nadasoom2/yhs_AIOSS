# ── Feature Flags ────────────────────────────────────────────────
# 각 플래그를 true/false 로 전환합니다.
# VITE_ 접두사 필수 (Vite 환경 변수 노출 규칙)

# 음성 입력 버튼 (채팅 입력창에 마이크 아이콘 표시)
VITE_FEATURE_VOICE_INPUT=true

# 다크 모드 테마
VITE_FEATURE_DARK_MODE=false

# 빠른 답변 칩 (채팅 화면 추천 질문 버튼)
VITE_FEATURE_QUICK_REPLIES=true

# ── 베타 사용자 화이트리스트 (쉼표 구분) ─────────────────────────
# VOICE_INPUT / QUICK_REPLIES 는 이 목록의 userId에게도 활성화됩니다.
VITE_BETA_USERS=user_beta1,user_beta2,user_001
